__pycache__/
*.py[cod]
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.cache/
.ultralytics/
Ultralytics/
.mplconfig/
.claude/
.codex/
.agents/
.aws/
.idea/
