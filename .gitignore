!.env.example

# Credentials and private keys must never be committed.
*.pem
*.ppk
*.key
*.p12
*.pfx

# Models and generated weight artifacts. Keep only documentation/manifests.
weights/**
!weights/README.md
!weights/manifest.json
!weights/.gitkeep
models/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.h5
*.hdf5
*.tflite
*.engine
*.npz

# Runtime outputs and private datasets.
storage/**
!storage/.gitkeep
artifacts/
outputs/
datasets/
test_images/

# Local databases, archives, packaging, and OS metadata.
*.db
*.sqlite
*.sqlite3
*.sqlite*
*.zip
*.tar
*.tar.gz
build/
dist/
*.egg-info/

# Image data is local unless a maintainer explicitly force-adds a fixture.
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tif
*.tiff
.DS_Store
Thumbs.db
