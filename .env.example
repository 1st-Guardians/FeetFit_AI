# Copy this file to .env and replace placeholders locally. Never commit .env.

# Shared internal authentication. This value must exactly match Feetfit_Server.
FEETFIT_SERVER_INTERNAL_API_KEY=replace-with-shared-internal-key

# Administrator-only verified shoe catalog ingestion. Keep disabled until the
# separate 32+ character admin key and a safe Server origin are configured.
SHOE_INGESTION_ENABLED=false
SHOE_INGESTION_ADMIN_API_KEY=replace-with-a-different-random-admin-key-at-least-32-characters
SHOE_INGESTION_TARGET_LABEL=production
FEETFIT_SERVER_BASE_URL=http://127.0.0.1:8080
SHOE_INGESTION_CRAWLER_ROOT=C:/Users/you/Desktop/shoe_crawler
SHOE_INGESTION_ARTIFACT_ROOT=C:/Users/you/Desktop/Feetfit_AI/artifacts/shoe-ingestion-jobs

# OpenAI report text generation
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_REPORT_MODEL=gpt-4.1-mini
OPENAI_REPORT_TEXT_ENABLED=true
OPENAI_FOOT_TYPE_TEXT_ENABLED=true
FOOT_TYPE_PRESSURE_BALANCE_TOLERANCE_PERCENT=5

# Feetfit_Server endpoints used by the AI service
TINEA_REPORT_ENDPOINT=http://127.0.0.1:8080/api/reports/tina-pedis
HALLUX_VALGUS_REPORT_ENDPOINT=http://127.0.0.1:8080/api/reports/hallux-valgus
FEETFIT_SERVER_RECOMMENDATION_ENDPOINT=http://127.0.0.1:8080/api/shoes/recommendations
FEETFIT_SERVER_SUMMARY_SAVE_ENDPOINT_TEMPLATE=http://127.0.0.1:8080/api/shoes/{shoe_id}/summaries
FEETFIT_SERVER_RECOMMENDATION_CONTEXT_ENDPOINT=http://127.0.0.1:8080/api/internal/shoe-analysis/recommendation-context
FEETFIT_SERVER_SUMMARY_CONTEXT_ENDPOINT_TEMPLATE=http://127.0.0.1:8080/api/internal/shoe-analysis/shoes/{shoe_id}/recommendation-summary-context
FEETFIT_SERVER_CHARACTERISTICS_ENDPOINT_TEMPLATE=http://127.0.0.1:8080/api/shoes/{shoe_id}/characteristics

# Local/external model assets. Distribute these outside Git.
WEIGHTS_DIR=C:/path/to/feetfit/weights
SAM_SOURCE_DIR=C:/path/to/segment-anything
HALLUX_MODEL_SOURCE_DIR=C:/path/to/hallux-model
HALLUX_LANDMARK_WEIGHTS=C:/path/to/hallux-best.pt
ARUCO_SOURCE_DIR=C:/path/to/aruco-marker-code
ARUCO_CAMERA_CALIBRATION=C:/path/to/hybrid_best_1280x720.npz
ARUCO_FOOT_SEGMENTATION_WEIGHTS=C:/path/to/foot-segmentation.pt

# Phase D runtimes
SHOE_EMBEDDING_DEVICE=auto
SHOE_EMBEDDING_LOCAL_FILES_ONLY=true
SHOE_RELEASE_EMBEDDING_MODEL_AFTER_BATCH=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_GPU=-1
OLLAMA_CPU_FALLBACK_ENABLED=true
OLLAMA_DIRECT_SUMMARY_DEADLINE_SECONDS=8.5
OLLAMA_KEEP_ALIVE=30m
# 8 GB GPU에서는 BGE-M3 추천 배치와 동시에 상주시키지 않도록 주의하세요.
OLLAMA_PREWARM_ON_STARTUP=false

# Optional operational audit tools only; not used by the AI HTTP runtime.
SHOE_DB_URL=
SHOE_DB_USERNAME=
SHOE_DB_PASSWORD=

# Optional helper: scripts/run_ngrok.py (ngrok auth stays in the user's ngrok config).
NGROK_PORT=8000
